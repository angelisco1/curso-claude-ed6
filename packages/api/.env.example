# Secreto para firmar los JWT (obligatorio, la API no arranca sin él)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Caducidad del access token (por defecto 15m)
JWT_EXPIRES_IN=15m
# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
